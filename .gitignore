# ==============================================================================
# Glass-ToDo monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# OS / editors
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

*.swp
*.swo
*.tmp
*.bak
.txt

.idea/
*.iml

# VS Code: uncomment if you don't want to commit workspace settings.
# .vscode/

# ------------------------------------------------------------------------------
# Logs / captures
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local debug artifacts in repo root.
android_logcat*.txt
logcat_stream.txt
flutter_run_capture.txt
emulator_screen*.png

# ------------------------------------------------------------------------------
# Dart / Flutter
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# ------------------------------------------------------------------------------
# Android / Gradle
# ------------------------------------------------------------------------------
**/.gradle/
**/.kotlin/
**/.cxx/
**/local.properties

# Signing keys (never commit)
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx

# ------------------------------------------------------------------------------
# Node.js
# ------------------------------------------------------------------------------
node_modules/

# Keep the bundled Node runtime used by `local_server/启动.bat`.
!local_server/bin/node_modules/
!local_server/bin/node_modules/**

# ------------------------------------------------------------------------------
# Local server runtime data
# ------------------------------------------------------------------------------
local_server/data/
local_server/backups/
local_server/storage/
local_server/database.sqlite
local_server/*.sqlite
local_server/*.sqlite3
local_server/*.db
local_server/*.db-journal
local_server/*.db-wal
local_server/*.db-shm
local_server/*.bak
local_server/server.out.log
local_server/server.err.log

# ------------------------------------------------------------------------------
# Flutter web publish output (generated)
# ------------------------------------------------------------------------------
local_server/public/.last_build_id
local_server/public/assets/
local_server/public/canvaskit/
local_server/public/favicon.ico
local_server/public/firebase-messaging-sw.js
local_server/public/flutter.js
local_server/public/flutter_bootstrap.js
local_server/public/flutter_service_worker.js
local_server/public/index.html
local_server/public/main.dart.js
local_server/public/manifest.json
local_server/public/version.json
local_server/public/icons/

# Cached runtime data (generated)
local_server/public/holidays/

# ------------------------------------------------------------------------------
# Env files (keep examples)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.docker.example

# ------------------------------------------------------------------------------
# Main workspace (excluded from git)
# ------------------------------------------------------------------------------
main/

# ------------------------------------------------------------------------------
# Release artifacts (excluded from git)
# ------------------------------------------------------------------------------
release/
