# =========================
# Glass Todo - Docker 部署用配置（模板）
# =========================
#
# 用法（在服务器上）：
# 1) 把本文件复制为 `.env.docker`
#    - Linux:   cp .env.docker.example .env.docker
#    - Windows: copy .env.docker.example .env.docker
# 2) 按需修改下面的配置
# 3) 启动（一定要带 --env-file，docker compose 才会读取 .env.docker）：
#    docker compose --env-file .env.docker up -d
#
# 查看状态/日志：
#   docker compose ps
#   docker compose logs -f --tail=200
#

# -------------------------------------------------------------------
# 1) Docker 镜像（Docker Hub）
# -------------------------------------------------------------------
# 你的镜像名格式：DockerHub用户名/仓库名
# 例如：hzc073/glass-todo-backend
DOCKER_IMAGE=hzc073/glass-todo-backend

# 镜像 tag（你 push 到 Docker Hub 的版本号）
# 你说使用 latest，就保持 latest
IMAGE_TAG=latest

# -------------------------------------------------------------------
# 2) 端口映射（主机端口 -> 容器端口 3000）
# -------------------------------------------------------------------
# 例：HOST_PORT=8080 表示外网访问 http://服务器IP:8080/
# （容器内部永远监听 3000，不建议改）
HOST_PORT=8080

# -------------------------------------------------------------------
# 3) 数据持久化（非常重要）
# -------------------------------------------------------------------
# 宿主机上保存数据的目录，会挂载到容器内 /app/data
# 建议用“绝对路径”（最不容易出错），例如：
#   HOST_DATA_DIR=/opt/glass-todo/data
# 也可以用相对路径（相对于 docker-compose.yml 所在目录）：
#   HOST_DATA_DIR=../data
HOST_DATA_DIR=../data

# -------------------------------------------------------------------
# 4) 数据库（PostgreSQL）
# -------------------------------------------------------------------
# Docker Compose 会同时启动一个 PostgreSQL 容器，并将数据持久化到：
#   ${HOST_DATA_DIR}/postgres
POSTGRES_USER=glass
POSTGRES_PASSWORD=glass
POSTGRES_DB=glass_todo

# -------------------------------------------------------------------
# 5) 应用运行配置（可选，但建议按需改）
# -------------------------------------------------------------------
# 前端跨域白名单（多个用逗号分隔）。上线建议不要用 *
# 例如：CORS_ORIGINS=https://todo.example.com
CORS_ORIGINS=*

# 前端调用后端的地址。通常留空（同源）即可。
# 如果你把前端单独放到其它域名/端口，再填后端公网地址，例如：
#   API_BASE_URL=https://todo.example.com
API_BASE_URL=

# 前端标题
APP_TITLE=Glass Todo

# 是否强制前端使用 LocalStorage（一般不需要）
USE_LOCAL_STORAGE=false

# 节假日数据源（不填就使用内置默认源；也可以配置多个，用逗号分隔）
# HOLIDAY_JSON_URL=https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/{year}.json
HOLIDAY_JSON_URL=

# -------------------------------------------------------------------
# 6) 附件（高级：可选）
# -------------------------------------------------------------------
# 默认使用本地存储（挂载到 /app/data/attachments）
# 如果你要用 S3/R2 存储附件，再打开下面这些配置：
#
# ATTACHMENTS_DRIVER=s3
# ATTACHMENTS_S3_BUCKET=your-bucket
# ATTACHMENTS_S3_REGION=auto
# ATTACHMENTS_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# ATTACHMENTS_S3_PREFIX=attachments/
# ATTACHMENTS_S3_ACCESS_KEY_ID=xxxxx
# ATTACHMENTS_S3_SECRET_ACCESS_KEY=xxxxx
