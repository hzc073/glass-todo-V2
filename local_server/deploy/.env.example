# =========================
# Glass Todo Local Server
# =========================

# 允许访问的前端 Origin（逗号分隔），示例：
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 留空或设置为 "*" 表示允许所有（生产环境不建议）。
CORS_ORIGINS=*

# 前端调用后端的地址。Web 端留空表示“同源”（推荐：当 Web 由后端静态目录提供时）。
# 示例：
# API_BASE_URL=http://localhost:3000
# API_BASE_URL=https://todo.example.com
API_BASE_URL=

# -------------------------
# 数据路径（Windows）
# -------------------------
# 数据库类型：`postgres` 或 `sqlite`
# - postgres：使用 `DATABASE_URL`
# - sqlite：使用 `DB_PATH`
DB_DRIVER=sqlite

# PostgreSQL 连接串示例：
# DATABASE_URL=postgresql://glass:glass@127.0.0.1:5432/glass_todo
DATABASE_URL=

# -------------------------
# 内置 PostgreSQL（Windows / 便携版）
# -------------------------
# 当 `DB_DRIVER=postgres` 且 `DATABASE_URL` 为空时，`run.bat` 可以自动启动“内置 PostgreSQL”：
# 1) 把 PostgreSQL（Windows binaries）解压到：`local_server/bin/postgres/`
#    （确保存在 `bin/postgres/bin/pg_ctl.exe`）
# 2) 设置 `AUTO_START_POSTGRES=true`，并配置下面的账号/密码/库名等。
AUTO_START_POSTGRES=false
# 后端退出时是否自动停止 PostgreSQL（默认 true）
STOP_POSTGRES_ON_EXIT=true
# PostgreSQL 可执行文件目录（默认：仓库内）
POSTGRES_BIN_DIR=./bin/postgres/bin
# PostgreSQL 数据目录（默认：仓库内）
POSTGRES_DATA_DIR=./data/postgres
# PostgreSQL 日志文件
POSTGRES_LOG_PATH=./data/postgres/postgres.log
# 启动等待超时（秒）
POSTGRES_START_TIMEOUT_SEC=15
# PostgreSQL 监听地址（建议 127.0.0.1）
POSTGRES_HOST=127.0.0.1
# PostgreSQL 端口（建议避免与系统已安装的 5432 冲突）
POSTGRES_PORT=54321
# 数据库账号/密码/库名
POSTGRES_USER=glass
POSTGRES_PASSWORD=glass
POSTGRES_DB=glass_todo

# SQLite：路径可以是绝对路径，也可以是相对于 `local_server/` 的相对路径（推荐）。
DB_PATH=./data/database.sqlite
ATTACHMENTS_DIR=./data/attachments

# Windows：服务监听端口。
PORT=3000

# -------------------------
# Docker（正式部署）
# -------------------------
# 端口映射（HOST_PORT -> 容器 3000）。
HOST_PORT=3000

# docker-compose 使用的镜像 tag。
IMAGE_TAG=local
