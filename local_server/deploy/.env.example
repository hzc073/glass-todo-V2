# =========================
# Glass Todo Local Server
# =========================

# Allowed frontend origins (comma-separated). Examples:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty or set to "*" to allow all (NOT recommended for production).
CORS_ORIGINS=*

# API base url for frontend. For Web, leaving it empty means "same origin" (recommended when web is served by backend).
# Examples:
# API_BASE_URL=http://localhost:3000
# API_BASE_URL=https://todo.example.com
API_BASE_URL=

# -------------------------
# Data locations (Windows)
# -------------------------
# Paths can be absolute or relative to `local_server/` (recommended).
DB_PATH=./data/database.sqlite
ATTACHMENTS_DIR=./data/attachments

# Windows: listen port (service port).
PORT=3000

# -------------------------
# Docker (production)
# -------------------------
# Host port mapping (HOST_PORT -> container 3000).
HOST_PORT=3000

# Image tag used by docker-compose build.
IMAGE_TAG=local
